CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
FRONTEND_URL=
SENTRY_DSN=

# Email (apps.meeting confirmation/reminder/reschedule/cancellation emails)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@mergixlabs.com

# Google Calendar (apps.meeting) - OAuth2 refresh-token flow, see apps/meeting/README.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token
GOOGLE_CALENDAR_ID=primary
GOOGLE_ADMIN_EMAIL=

# Meeting Scheduling (apps.meeting)
MEETING_TIMEZONE=Asia/Kolkata
MEETING_WORKING_DAYS=0,1,2,3,4
MEETING_WORKING_HOURS_START=09:00
MEETING_WORKING_HOURS_END=18:00
MEETING_SLOT_DURATION_MINUTES=30
MEETING_BUFFER_MINUTES=0
MEETING_MIN_NOTICE_MINUTES=60
MEETING_MAX_ADVANCE_DAYS=30
MEETING_REMINDER_LEAD_MINUTES=60
MEETING_DEFAULT_TITLE_PREFIX=Meeting with
MEETING_LOG_LEVEL=INFO
