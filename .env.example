# Copy to .env for local development. On Render, these are set as environment
# variables per-service in render.yaml (secrets marked sync: false must be filled
# in manually in the Render dashboard after the first Blueprint deploy).

# --- Django core ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
# Comma-separated hostnames, no scheme. Render example: myapp.onrender.com,api.mydomain.com
ALLOWED_HOSTS=127.0.0.1,localhost
# Comma-separated, full origin with scheme, no trailing slash.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://127.0.0.1,http://localhost:3000
# Comma-separated, full origin with scheme. Required in production if the frontend
# is a different origin (Django CSRF requires this for cross-site POSTs over HTTPS).
CSRF_TRUSTED_ORIGINS=

# --- Database ---
# Leave unset for local dev to fall back to sqlite. Render injects this automatically
# for the managed Postgres database declared in render.yaml.
DATABASE_URL=

# --- Media (Persistent Disk on Render, local ./media otherwise) ---
# Leave commented out locally to use the default (BASE_DIR/media). On Render this is
# set to /app/media (the Persistent Disk mount path) via render.yaml.
# MEDIA_ROOT=/app/media

# --- JWT / auth cookies (apps.users) ---
ACCESS_TOKEN_LIFETIME=15
REFRESH_TOKEN_LIFETIME=10080
AUTH_COOKIE_SECURE=False
AUTH_COOKIE_HTTP_ONLY=True
AUTH_COOKIE_SAMESITE=Lax
AUTH_COOKIE_DOMAIN=None

# --- Security flags -- LEAVE THESE COMMENTED OUT to get the DEBUG-appropriate default
# (see core/settings.py). python-decouple treats a present-but-empty value as an explicit
# override (False/0), NOT as "unset" -- so uncomment only if you want to force a value.
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=604800

# --- Email (apps.meeting confirmation/reminder/reschedule/cancellation emails) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@mergixlabs.com

# --- Mailjet (core.tasks.send_forgot_email) ---
MAILJET_API_KEY=
MAILJET_SECRET_KEY=

# --- Google Calendar (apps.meeting) -- OAuth2 refresh-token flow, see apps/meeting/README.md ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token
GOOGLE_CALENDAR_ID=primary
GOOGLE_ADMIN_EMAIL=

# --- Meeting scheduling (apps.meeting) ---
MEETING_TIMEZONE=Asia/Kolkata
MEETING_WORKING_DAYS=0,1,2,3,4
MEETING_WORKING_HOURS_START=09:00
MEETING_WORKING_HOURS_END=18:00
MEETING_SLOT_DURATION_MINUTES=30
MEETING_BUFFER_MINUTES=0
MEETING_MIN_NOTICE_MINUTES=60
MEETING_MAX_ADVANCE_DAYS=30
MEETING_REMINDER_LEAD_MINUTES=60
MEETING_DEFAULT_TITLE_PREFIX=Meeting with
MEETING_LOG_LEVEL=INFO

# --- apps.fintech_ai ---
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
GEMINI_API_KEY=

# --- Frontend / misc ---
FRONTEND_URL=http://localhost:3000
DJANGO_LOG_LEVEL=INFO
SENTRY_DSN=

# --- Celery / Redis ---
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
